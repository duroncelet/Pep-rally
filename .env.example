# Pep Rally accounts (Clerk). Add real values only to ignored local env files
# and to Cloudflare's secret manager.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional: enables Stripe test checkout. Use test-mode credentials only during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reserved for AI-assisted Rally features. The current prototype does not require it.
OPENAI_API_KEY=
